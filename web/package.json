{
  "name": "ephyra-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --cache --cache-strategy content --ignore-unknown .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run typecheck"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.145",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/mdc": "^0.23.2",
    "nuxt": "^4.6.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.0",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "vue-demi@0.14.10": true
  }
}
